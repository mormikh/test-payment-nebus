# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app_secret
POSTGRES_DB=payments
DATABASE_URL=postgresql+asyncpg://app:app_secret@postgres:5432/payments

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# App
API_KEY=super-secret-api-key
LOG_LEVEL=INFO